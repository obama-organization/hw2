[setup]
%{ for name, n in nodes ~}
%{ if n.role == "setup" ~}
${name} ansible_host=${n.ip}
%{ endif ~}
%{ endfor ~}

[control_plane]
%{ for name, n in nodes ~}
%{ if n.role == "control_plane" ~}
${name} ansible_host=${n.ip}
%{ endif ~}
%{ endfor ~}

[workers]
%{ for name, n in nodes ~}
%{ if n.role == "worker" ~}
${name} ansible_host=${n.ip}
%{ endif ~}
%{ endfor ~}

[k8s_cluster:children]
control_plane
workers

[all:vars]
ansible_user=${user}
ansible_ssh_private_key_file=${key_path}
