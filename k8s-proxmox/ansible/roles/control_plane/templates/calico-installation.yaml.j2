---
apiVersion: operator.tigera.io/v1
kind: Installation
metadata:
  name: default
spec:
  calicoNetwork:
    bgp: Disabled
    ipPools:
      - name: default-ipv4-ippool
        blockSize: 26
        cidr: "{{ pod_network_cidr }}"
        encapsulation: VXLAN
        natOutgoing: Enabled
        nodeSelector: all()
