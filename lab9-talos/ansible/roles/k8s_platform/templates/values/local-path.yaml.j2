# {{ ansible_managed }}
storageClass:
  create: true
  name: local-path
  defaultClass: true
  defaultVolumeType: local
  reclaimPolicy: Delete
  volumeBindingMode: WaitForFirstConsumer
nodePathMap:
  - node: DEFAULT_PATH_FOR_NON_LISTED_NODES
    paths:
      - /var/mnt/local-path-provisioner
resources:
  requests: { cpu: 10m, memory: 24Mi }
  limits: { memory: 128Mi }
